{
  "name": "ng-lead",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "start:prod": "ng serve --configuration=production",
    "build": "ng build --localize",
    "build:prod": "ng build --configuration=production",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "test": "CHROME_BIN=/usr/local/bin/chrome ng test",
    "e2e": "ng e2e",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "prepare": "cd .. && husky ng-lead/.husky",
    "update:flow": "ng g @angular/core:control-flow"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.4",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^20.1.4",
    "@angular/compiler": "^20.1.4",
    "@angular/core": "^20.1.4",
    "@angular/forms": "^20.1.4",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^20.1.4",
    "@angular/platform-browser-dynamic": "^20.1.4",
    "@angular/router": "^20.1.4",
    "@ngrx/data": "^20.0.0",
    "@ngrx/effects": "^20.0.0",
    "@ngrx/entity": "^20.0.0",
    "@ngrx/store": "^20.0.0",
    "@ngrx/store-devtools": "^20.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.1.4",
    "@angular/cli": "^20.1.4",
    "@angular/compiler-cli": "^20.1.4",
    "@angular/localize": "^20.1.4",
    "@ngrx/schematics": "^20.0.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "18.3.1",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.2.0"
  }
}